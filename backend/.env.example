APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18. The sponsorship hierarchy uses ltree materialized paths, so
# Postgres is a hard requirement rather than a preference — see
# docs/quantum-life-solutions/05-network.md in the reference repo.
# Port 5433 is the PG 18 cluster; 5432 is an older PG 16 cluster on the same host.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=quantumlife_db
DB_USERNAME=quantumlife
DB_PASSWORD=

# ── Pre-launch phase ──────────────────────────────────────────────────────────
# While this is true the member area narrows to enrolling partners and placing
# them. Sections are closed by route-name prefix in config/prelaunch.php; open
# them on launch day by removing keys there, one at a time, rather than
# flipping this flag — a staged opening is recoverable, a flag flip is not.
# Leave false in dev and CI so the whole application is exercised.
QL_PRELAUNCH=false

# Drives the countdown on the coming-soon page. Leave unset while the date
# might still slip: a countdown that resets is worse than no countdown.
QL_PRELAUNCH_ENDS_AT=

# ── Registration ──────────────────────────────────────────────────────────────
# Invitation-only signup. While true, the general /register form and
# /api/auth/register are closed; the only way in is a partner's /join/{code}
# link, which carries the sponsor.
#
# Defaults to TRUE in config/registration.php if unset — unlike QL_PRELAUNCH,
# because this is an access control and one that defaults open is open on the
# environment somebody forgot to configure.
#
# The first account cannot come from an invitation, so create it with:
#   php artisan founder:create founder@example.com --name="Jane Doe"
QL_INVITE_ONLY=true

# Partner websites are {QL_SITE_URL}/{referral code}. Dev: https://q3.onlinebros.com/site
QL_SITE_URL=https://q3.life

# ── Genealogy ─────────────────────────────────────────────────────────────────
# Placement structure. 'unilevel' places every partner directly beneath their
# sponsor, with no spillover. The schema supports binary and matrix without a
# migration — adding one means adding a strategy class, not changing columns.
QL_GENEALOGY_STRUCTURE=unilevel

# How deep the member-facing tree renders in one request.
QL_TREE_DEPTH=5

# User id that unreferred signups are placed under. Leave unset to let them
# become roots of their own tree.
QL_DEFAULT_SPONSOR_ID=

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Run `php artisan billing:bootstrap-product` to create the product and price,
# then `php artisan billing:preflight` before opening billing to anyone.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_API_VERSION=2025-08-27.basil

# Two endpoints, two secrets. Platform events sign with the first, connected
# account (payout) events with the second — each is verified against its own.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_CONNECT_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# Printed by billing:bootstrap-product.
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=

# Only read when bootstrap-product creates the price. Amount is in minor units
# (19900 = $199.00). Prices are immutable at the provider — changing this later
# means creating a new price, not editing the existing one.
STRIPE_PRODUCT_NAME="Quantum Life Partner Membership"
STRIPE_PRICE_AMOUNT=19900
STRIPE_CURRENCY=usd
STRIPE_PRICE_INTERVAL=year

# Trial for anyone signing up after launch. Pre-launch signups park on a
# placeholder trial this many days out until billing:apply-prelaunch-end moves
# them onto the real schedule.
STRIPE_TRIAL_DAYS=30
STRIPE_PRELAUNCH_PLACEHOLDER_DAYS=365

# How long a past_due subscription keeps access after its period ends. A
# deliberate policy value, not an accident of which statuses the gate lists.
STRIPE_GRACE_DAYS=7

# Stops one physical card backing two accounts.
STRIPE_ENFORCE_CARD_UNIQUENESS=true

# ── Payouts (Stripe Connect) ─────────────────────────────────────────────────
# Partners set up the account their commissions are paid into on Get Paid.
# `application` keeps onboarding inside our page with no Stripe sign-in pop-up;
# the platform must have accepted responsibility for connected accounts in
# Stripe's Connect settings. Connected-account events arrive on
# /api/webhooks/stripe/connect, signed with STRIPE_WEBHOOK_CONNECT_SECRET.
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_COUNTRY=US
# Shown to Stripe on every partner account. The company site, never a referral link.
STRIPE_CONNECT_BUSINESS_URL=https://q3.life
STRIPE_CONNECT_PRODUCT_DESCRIPTION="Referral commissions from product sales and marketing through Quantum 3 Solution platform"
STRIPE_CONNECT_HOSTED_FALLBACK=true
STRIPE_CONNECT_REQUIREMENT_COLLECTION=application
STRIPE_CONNECT_TAX_REPORTING=true
STRIPE_CONNECT_FEES_PAYER=application
STRIPE_CONNECT_LOSSES_PAYER=application
# Stops one real bank account being attached under two partners.
STRIPE_ENFORCE_CONNECT_UNIQUENESS=true

# Use "database" (or redis) in production — keeps session data server-side
# and only an opaque session ID in the cookie. The "cookie" driver stores the
# full payload in the cookie itself; acceptable but less defensible.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie hardening — required for SPA auth (no JWT in localStorage).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum SPA auth — comma-separated list of front-end domains allowed to
# authenticate via the session cookie.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production: MAIL_MAILER=resend (HTTPS API; DigitalOcean blocks SMTP 587/465)
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vimeo API (get a personal access token with "upload" scope from developer.vimeo.com)
VIMEO_ACCESS_TOKEN=
VIMEO_PRIVACY=disable

# ── Vendor referrals ─────────────────────────────────────────────────────────
# Third-party products our partners sell on the vendor's own checkout.
# See memory-bank/vendor-referral-framework.md.

# Prefix for the reference we pass as Stripe's client_reference_id. Must stay
# inside that field's charset: letters, digits, dash, underscore.
VENDOR_REF_PREFIX=QLV

PLASMAGUARD_ENABLED=true
PLASMAGUARD_CHECKOUT_URL=https://buy.stripe.com/cNi3cv4zF1tE4RBfYY5J600
PLASMAGUARD_SUPPORT_EMAIL=info@plasmaguard.com

# Signing secret from PLASMAGUARD's Stripe account, not ours. Until they supply
# it, /api/webhooks/vendor/plasmaguard answers 503 and conversions are recorded
# by hand from the admin screen — that is the designed fallback, not a fault.
PLASMAGUARD_WEBHOOK_SECRET=

# Backstop for missed webhooks: every 15 minutes the scheduler reads
# PlasmaGuard's event log and records anything the endpoint never received.
# Nothing is fetched until SINCE is set (ISO 8601). Set it to when the webhook
# went live, so orders paid before then are never replayed into sales.
PLASMAGUARD_EVENT_SYNC=true
PLASMAGUARD_EVENT_SYNC_SINCE=

# How far back the email fallback will look when a confirmation arrives with no
# reference. Unbounded matching eventually credits a stranger's purchase to
# whoever once entered that address.
PLASMAGUARD_MATCH_WINDOW_DAYS=30

# Commercial terms. Set clawback_days no shorter than the vendor's own refund
# window, or we pay out on orders they can still refund.
PLASMAGUARD_COMMISSION_RATE=0.10
PLASMAGUARD_CLAWBACK_DAYS=60

# Display price only. Leave unset until PlasmaGuard confirms what their checkout
# actually charges — the confirmation payload is what gets recorded either way.
PLASMAGUARD_PRO_PRICE=

# ── PlasmaGuard order pricing ────────────────────────────────────────────────
# Confirmed by PlasmaGuard 2026-09-08: Stripe Tax handles tax on their account;
# we compute shipping and add a flat processing fee on top of it.
#   total = subtotal + shipping + handling + tax

PLASMAGUARD_SHIPPING_MODE=live
PLASMAGUARD_SHIPPING_FLAT=0

# PlasmaGuard's own FedEx account, so quotes use their negotiated rates.
# The account NUMBER alone does not authorise rating — FedEx API credentials are
# needed, and the carrier account must be registered with the rating provider.
# EASYPOST id is filled in once that registration is done.
PLASMAGUARD_FEDEX_ACCOUNT=769848738
PLASMAGUARD_CARRIER_ACCOUNT=

# Fail a quote rather than silently falling back to FedEx published rates, which
# are materially higher than their negotiated ones.
PLASMAGUARD_REQUIRE_NEGOTIATED=true

# Ship-from, confirmed 2026-09-09. Defaults are in config/vendors.php.
PLASMAGUARD_ORIGIN_LINE1="30933 Industrial Rd."
PLASMAGUARD_ORIGIN_CITY=Livonia
PLASMAGUARD_ORIGIN_STATE=MI
PLASMAGUARD_ORIGIN_POSTAL=48150
PLASMAGUARD_ORIGIN_COUNTRY=US

# One unit per carton, 45 per pallet. Above this many units, route to a human
# for an LTL freight quote instead of quoting parcel badly.
PLASMAGUARD_FREIGHT_THRESHOLD=8

# The $12 processing fee, in minor units. `BASIS` is order|unit — on a
# three-unit order that is the difference between $12 and $36. Defaulted to the
# reading that cannot overcharge; confirm with PlasmaGuard before launch.
PLASMAGUARD_HANDLING_AMOUNT=1200
PLASMAGUARD_HANDLING_BASIS=order

# Stripe's shipping tax code, applied to the combined shipping+handling line.
PLASMAGUARD_SHIPPING_TAX_CODE=txcd_92010001

# ── PlasmaGuard revenue share ────────────────────────────────────────────────
# Confirmed 2026-09-09: a flat $3,000 per system sold, so 3 units pays us
# $9,000. Taken at source as the Stripe Connect application fee.
#
# per_unit, NOT a percentage. At the current $6,000 price a flat $3,000 happens
# to equal 50%, but the two diverge the moment anything is discounted.
PLASMAGUARD_REVENUE_SHARE_MODEL=per_unit

# Our cut per system, in minor units. Deliberately not derived from the price —
# if PlasmaGuard discount the system, a person decides whether this moves.
PLASMAGUARD_PRO_SHARE_PER_UNIT=300000

# Used only when the model is 'rate'.
PLASMAGUARD_REVENUE_SHARE_RATE=0.50

# Who absorbs Stripe's ~2.9% + 30c. With Connect direct charges the connected
# account pays by default, computed on the full charge including tax and
# shipping — roughly $190 on a $6,612 order, all from PlasmaGuard's half.
# Agree in writing before the first live order.
PLASMAGUARD_STRIPE_FEE_PAYER=vendor

# A refund does not return the application fee automatically. On a 50/50 split
# that is $3,000 leaving our balance.
PLASMAGUARD_REFUND_APP_FEE=true

# What we pay the PARTNER, out of our share — not out of the order total.
PLASMAGUARD_COMMISSION_BASIS=revenue_share

# Cloudflare Turnstile — bot check on the public website contact form
# (POST /api/support/requests). Fails closed: with no secret the endpoint
# answers 503. TURNSTILE_ALLOWED_HOSTNAMES is a comma-separated list of hostnames
# the token must have been issued on; leave it empty only with Cloudflare's test
# keys, which return a dummy hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# ── Screen recordings ─────────────────────────────────────────────────────────
# Recordings go to the 'spaces' disk, which falls back to the AWS_* values
# above. Set SPACES_* only to use a different bucket. With no bucket at all — a
# dev box — they fall back to the local public disk and still work end to end.
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_URL=
# Overrides for config/screen-recordings.php. The chunk size is clamped at
# runtime to what PHP will accept, and nginx's client_max_body_size must be at
# least as large (8m is comfortable). Trim and combine need ffmpeg/ffprobe on
# the host and a running queue worker.
RECORDINGS_DISK=
RECORDINGS_CHUNK_BYTES=4194304
RECORDINGS_MAX_DURATION=7200
RECORDINGS_LINK_TTL=180
FFMPEG_PATH=/usr/bin/ffmpeg

# ── Presentations ─────────────────────────────────────────────────────────────
# While false the feature is admin-only: hidden from the partner sidebar and
# closed to non-admins. Guest pages (/watch, /flow) are never gated — a guest
# is an ordinary person with a link.
PRESENTATIONS_OPEN_TO_MEMBERS=false
# Showings are booked in New York time; EST/EDT switches on its own.
PRESENTATIONS_TIMEZONE=America/New_York
PRESENTATIONS_MEMBERS_CAN_SCHEDULE=true
PRESENTATIONS_MEMBER_LIMIT=20
# How long before the start the video becomes fetchable, for buffering.
PRESENTATIONS_PRELOAD_SECONDS=120
# How long either side of a call the all-rooms console keeps it open.
PRESENTATIONS_CONSOLE_WINDOW=30
# What a new showing's button asks for: join | schedule_call | custom | none.
PRESENTATIONS_DEFAULT_CTA=join
